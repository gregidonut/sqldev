---
import Main from "@/components/main/Main.astro";
import Header from "@/components/header/Header.astro";
import Layout from "@/layouts/Layout.astro";

import RACCRUDTable from "./_components/react/RACCRUDTable/index.tsx";

import PageNav from "../_components/react/PageNav";
import { parseObjectsTab, type ObjectsTab } from "@/utils/storage/objectsTab";
import { requirePageAuth } from "@/utils/clerk/requireAuth";
import { Resource } from "sst";

const redirect = requirePageAuth(Astro);
if (redirect) return redirect;

const { driveTab } = Astro.params;

let tab: ObjectsTab;
try {
    tab = parseObjectsTab(driveTab ?? null);
} catch {
    return Astro.redirect("/drive/public", 302);
}

const { userId } = Astro.locals.auth();
---

<Layout title="drive">
    <Header title="drive" />
    <Main>
        <div class="flex-row-start items-start gap-2.5">
            <PageNav client:only="react" tab={tab} />
            <section class="flex-col-start-start min-w-0 flex-1">
                <RACCRUDTable
                    client:only="react"
                    tab={tab}
                    bucketName={Resource.SQLDevBucket.name}
                    userId={userId ?? ""}
                />
            </section>
        </div>
    </Main>
</Layout>
