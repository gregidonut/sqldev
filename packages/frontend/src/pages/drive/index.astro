---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";
import Main from "@/components/main/Main.astro";
import { requirePageAuth } from "@/utils/clerk/requireAuth";

const redirect = requirePageAuth(Astro);
if (redirect) return redirect;

return Astro.redirect("/drive/public", 302);
---

<Layout title="drive">
    <Header title="drive" />
    <Main />
</Layout>
