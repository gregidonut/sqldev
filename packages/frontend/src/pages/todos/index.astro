---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/Header.astro";
import Main from "@/components/main/Main.astro";
import LazyLoadedTodoSpaceList from "./_components/react/LazyLoadedTodoSpaceList";
import FormSection from "./_components/react/FormSection";

import { requirePageAuth } from "@/utils/clerk/requireAuth";
import { Resource } from "sst";

const redirect = requirePageAuth(Astro);
if (redirect) return redirect;

const { userId } = Astro.locals.auth();
---

<Layout>
    <Header />
    <Main>
        <FormSection client:only="react" />
        <LazyLoadedTodoSpaceList
            client:only="react"
            realtimeEndpoint={Resource.SQLDevRealtimeSST.endpoint}
            realtimeAuthorizer={Resource.SQLDevRealtimeSST.authorizer}
            appName={Resource.App.name}
            appStage={Resource.App.stage}
            clerkUserId={userId ?? ""}
        />
    </Main>
</Layout>
