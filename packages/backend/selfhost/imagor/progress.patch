+// SetFrameProgress receives one report after each exported output frame.
+// total is the planned timestamp count, which already includes duration and frame caps.
+func (av *AVContext) SetFrameProgress(progress func(phase string, completed, total int)) {
+	av.progress = progress
+}
+
+// SetProgressContext stops ExportFrames when the caller cancels.
+func (av *AVContext) SetProgressContext(ctx context.Context) {
+	av.progressCtx = ctx
+}
+
+func (av *AVContext) reportFrames(completed, total int) {
+	if av.progress == nil || total < 1 || completed < 0 || completed > total {
+		return
+	}
+	av.progress("frames", completed, total)
+}
